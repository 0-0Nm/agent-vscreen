    <string name="settings_section_session">Session</string>
    <string name="vscreen_title">Background Operation</string>
    <string name="vscreen_enable">Enable Background Operation</string>
    <string name="vscreen_enable_footer">Off by default. Enabling does not mean connected, and never turns on Accessibility, wireless debugging or grants permissions by itself. When off, nothing continues tapping on the main screen.</string>
    <string name="vscreen_enhanced">Enhanced Planning (Experimental)</string>
    <string name="vscreen_enhanced_footer">Summarizes action results and re-plans at better moments. Off by default; takes effect on the next send, continue or retry. The running task keeps its mode. Turning it off does not undo actions or clear chat history.</string>
