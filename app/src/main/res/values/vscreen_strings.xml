    <string name="vscreen_open_permissions">Open permission settings</string>
    <string name="vscreen_screen_size">Screen size</string>
    <string name="vscreen_screen_size_auto">Matches main screen</string>
    <string name="vscreen_screen_size_footer">Each background screen uses the main screen size and density. After a task ends or is stopped the screen is released and the connection kept; the next background task creates a screen automatically. Stop &amp; release, turning the feature off, or a lost connection require reconnecting.</string>
    <string name="vscreen_section_preview">Preview</string>
    <string name="vscreen_show_preview">Show preview</string>
    <string name="vscreen_show_preview_hint">Shown once connected.</string>
    <string name="vscreen_preview_footer">Shows the screen here and in the owning chat. The chat mini window can be dragged, pinched, collapsed and expanded. Collapsing or leaving stops preview refresh; the task can still read the screen. The screen is released when the task ends; checking status or the window never recreates it. No overlay permission needed.</string>
    <string name="vscreen_stop_release">Stop &amp; release</string>
    <string name="vscreen_stop_release_footer">Stops background operation and releases the display. Nothing moves to the foreground to keep tapping. To turn the feature off, use the switch at the top.</string>
