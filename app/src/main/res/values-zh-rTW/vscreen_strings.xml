    <!-- [vscreen] 后台操作 -->
    <string name="settings_section_session">會話</string>
    <string name="vscreen_title">背景操作</string>
    <string name="vscreen_enable">啟用背景操作</string>
    <string name="vscreen_enable_footer">預設關閉。啟用不等於連線就緒，也不會自動開啟無障礙、無線除錯或授予許可權。關閉後不會轉到前臺繼續點選。</string>
    <string name="vscreen_enhanced">增強規劃（實驗）</string>
    <string name="vscreen_enhanced_footer">自動彙總執行結果並最佳化規劃時機。預設關閉，下一次傳送、繼續或重試任務生效；當前任務保持原模式。關閉不會撤銷已執行動作，也不會清除聊天記錄。</string>
    <string name="vscreen_section_connection">連線與許可權</string>
    <string name="vscreen_connection">背景連線</string>
    <string name="vscreen_display_id">顯示 ID</string>
    <string name="vscreen_privilege">特權連線 / 授權</string>
    <string name="vscreen_accessibility">無障礙服務</string>
    <string name="vscreen_connect">連線</string>
    <string name="vscreen_open_permissions">開啟許可權設定</string>
    <string name="vscreen_screen_size">畫面尺寸</string>
    <string name="vscreen_screen_size_auto">自動適配主屏</string>
    <string name="vscreen_screen_size_footer">每次建屏自動使用主屏尺寸和密度。正常結束或停止聊天回答後釋放畫面、保留連線，下次開啟背景應用自動建屏。設定中的停止並釋放、關閉功能或連線失效仍需明確重連。</string>
    <string name="vscreen_section_preview">預覽</string>
    <string name="vscreen_show_preview">顯示預覽</string>
    <string name="vscreen_show_preview_hint">連線就緒後顯示預覽。</string>
    <string name="vscreen_preview_footer">在本頁和所屬聊天頁顯示畫面，聊天小屏可拖動、雙指縮放、收起和放大。收起或離開頁面停止預覽重新整理，但任務中的讀屏仍可用。任務結束後釋放畫面；查詢狀態或檢視小窗不會重新建屏。不需要系統懸浮窗許可權。</string>
    <string name="vscreen_stop_release">停止並釋放</string>
    <string name="vscreen_stop_release_footer">停止並釋放會終止背景操作並釋放顯示資源，不會轉到前臺繼續點選。若要關閉功能，請使用頂部開關。</string>
